# Copy this file to .env.local and fill in your actual values

# Supabase — Settings -> API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — Settings -> API Keys & Webhooks in your Paystack dashboard
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Resend — API Keys in your Resend dashboard (requires a verified sending domain)
RESEND_API_KEY=

# Your production site URL (used in metadata, sitemap, robots.txt, and email links)
NEXT_PUBLIC_SITE_URL=

# A secret string you choose yourself, used to authenticate Vercel cron requests
# to your auto-checkout and reminder-email endpoints
CRON_SECRET=
